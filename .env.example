# .env 양식 (키가 들어 있지 않은 사본)
#
# 이 파일을 .env 로 복사한 뒤 = 뒤에 실제 키를 채워 쓰세요.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env 는 .gitignore 에 걸려 있어 GitHub 에 올라가지 않습니다.
# 이 파일(.env.example)만 올라갑니다 — 여기에는 절대 실제 키를 넣지 마세요.
# 키를 채운 뒤에는 서버(python app.py)를 다시 실행해야 적용됩니다.

# 이미지 생성(imagegen.py) · 메모 분류(memo_tagger.py) ·
# 경북 이슈 웹 검색(gb_issues.py) 에서 씁니다.
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 고용 통계(고용률·실업률·생산가능인구) 조회용 — kosis_stats.py 에서 씁니다.
# 발급: https://kosis.kr/openapi/ (무료)
KOSIS_API_KEY=
