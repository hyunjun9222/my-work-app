# Streamlit Secrets 서식 (실제 값은 넣지 마세요 — 이 파일은 GitHub 에 올라갑니다).
#
# share.streamlit.io 배포 시 → 앱 → Settings → Secrets 에 아래 형식으로 직접 붙여넣습니다.
# (로컬에서 streamlit 으로 시험할 때만 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채우세요.
#  secrets.toml 은 .gitignore 로 막혀 있어 올라가지 않습니다.)

# 관리자 로그인 비밀번호 (아이디는 admin 고정). Streamlit Cloud 는 저장소가
# 재시작마다 초기화되므로, 이 값으로 관리자 계정을 매번 같은 비밀번호로 복구한다.
ADMIN_PASSWORD = "여기에-관리자-비밀번호"

# AI 기능(챗봇·이미지·경북 이슈)에서만 필요
OPENAI_API_KEY = ""

# 고용 통계(KOSIS)에서만 필요
KOSIS_API_KEY = ""
